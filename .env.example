# Variables d'environnement lues par les scripts de FinCAC40.
# Les scripts lisent l'environnement du processus : ils ne chargent pas ce
# fichier automatiquement. Définissez les variables dans votre terminal :
#
#   PowerShell :  $env:MISTRAL_API_KEY = "..."
#   bash/zsh   :  export MISTRAL_API_KEY="..."
#
# ou copiez ce fichier en .env (exclu de git) puis, sous bash :
#   set -a; source .env; set +a
#
# Ne versionnez jamais une vraie clé.

# Requise : benchmark (open-mistral-7b, mistral-large-latest), paires ORPO,
# annotation de masse.
MISTRAL_API_KEY=

# Optionnelles : benchmark multi-modèles (GPT-4o, Claude).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Publication Hugging Face : utilisez plutôt `huggingface-cli login`.
# HF_TOKEN=
